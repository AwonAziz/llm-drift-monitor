# ── LLM backends ──────────────────────────────────────────────────────
# The application under observation. `ollama` is the default: no API key, and
# nothing leaves the machine.
LDM_LLM_PROVIDER=ollama
LDM_LLM_MODEL=qwen3:8b
LDM_LLM_TEMPERATURE=0.0
LDM_LLM_MAX_TOKENS=220

# Hosted alternatives (set the matching key and switch the provider):
#   LDM_LLM_PROVIDER=openai     + OPENAI_API_KEY
#   LDM_LLM_PROVIDER=anthropic  + ANTHROPIC_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── LLM-as-judge ───────────────────────────────────────────────────────
# `auto` picks the first working backend: ollama -> openai -> anthropic -> mock.
LDM_JUDGE_PROVIDER=auto
LDM_JUDGE_MODEL=qwen3:8b
LDM_JUDGE_TEMPERATURE=0.0
LDM_JUDGE_MAX_TOKENS=320
LDM_JUDGE_SAMPLE_SIZE=24
LDM_JUDGE_MAX_WORKERS=4
LDM_JUDGE_REGRESSION_Z=2.0
LDM_JUDGE_MIN_KAPPA=0.30
# Change the rubric and you invalidate every historical comparison. Bump it.
LDM_JUDGE_RUBRIC_VERSION=v1.0.0

# ── Embeddings ─────────────────────────────────────────────────────────
# auto -> sentence-transformers if importable, else the offline hashing encoder.
LDM_EMBEDDING_BACKEND=auto
LDM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LDM_EMBEDDING_DIM=128
LDM_HASHING_FEATURES=65536

# ── Local Ollama ───────────────────────────────────────────────────────
LDM_OLLAMA_HOST=http://localhost:11434

# ── Drift thresholds ───────────────────────────────────────────────────
# Raise these to alert less. Measure the null firing rate before you touch them.
LDM_MMD_MODERATE=0.0030
LDM_MMD_SEVERE=0.0150
LDM_SWD_MODERATE=0.0055
LDM_SWD_SEVERE=0.0120
LDM_CENTROID_COS_MODERATE=0.030
LDM_CENTROID_COS_SEVERE=0.070
LDM_DOMAIN_AUC_MODERATE=0.62
LDM_DOMAIN_AUC_SEVERE=0.78
LDM_FRECHET_MODERATE=0.08
LDM_FRECHET_SEVERE=0.25
LDM_NOVELTY_MODERATE=0.25
LDM_NOVELTY_SEVERE=0.50
# How many embedding detectors must agree before drift is raised.
LDM_EMBEDDING_DRIFT_VOTES=2
LDM_PSI_MODERATE=0.10
LDM_PSI_SEVERE=0.25

# ── Quality thresholds (absolute drops / deltas from the baseline) ─────
LDM_ACC_DROP_WARN=0.03
LDM_ACC_DROP_CRITICAL=0.08
LDM_ECE_WARN=0.06
LDM_ECE_CRITICAL=0.12
LDM_BRIER_WARN=0.15
LDM_BRIER_CRITICAL=0.22
LDM_ABSTENTION_JUMP=0.15

# ── Monitor cadence ────────────────────────────────────────────────────
LDM_WINDOW_SIZE=250
LDM_MIN_WINDOW=40
LDM_REFERENCE_SIZE=1500
LDM_LLM_RESPONSE_SAMPLE=40
LDM_MMD_PERMUTATIONS=200
LDM_DOMAIN_CV_FOLDS=5
LDM_WASSERSTEIN_PROJECTIONS=256
LDM_DRIFT_N_BINS=10

# ── Policy ─────────────────────────────────────────────────────────────
# Off by default: a retrain is a human decision until you have measured the
# false-positive rate of the policy in your own traffic.
LDM_AUTO_RETRAIN=false

# ── Serving ────────────────────────────────────────────────────────────
LDM_API_HOST=127.0.0.1
LDM_API_PORT=8000
LDM_LOG_LEVEL=INFO

# ── Hugging Face (optional, avoids rate limits on first model download) ─
# HF_TOKEN=
