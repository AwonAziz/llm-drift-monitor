# one example report are committed so the dashboard and the README's "open the
# report" step work immediately after clone.
data/raw/
data/cache/
data/runs/
data/bundled/
data/telemetry.db
data/*.db
data/*.jsonl
data/reference/*.csv
data/reports/*
!data/reports/.gitkeep
!data/reports/example_*.html

